# Frontend Environment Variables

# API URL for backend
# Development (local): http://localhost:8090
# Development (Docker): http://127.0.0.1:18090
VITE_API_URL=http://localhost:8090

# Frontend port (optional, defaults to 5173)
# VITE_PORT=5173

# Requests table animation interval in milliseconds (optional, defaults to 500)
# VITE_REQUESTS_ANIMATION_INTERVAL=500

# GitHub repository and ref used by repository links and the developer model catalog
VITE_GITHUB_REPOSITORY=shay-wong/axonhub
VITE_GITHUB_REF=beta

# Optional direct catalog URL overrides
# VITE_PROVIDER_CATALOG_URL=https://raw.githubusercontent.com/ThinkInAIXYZ/PublicProviderConf/refs/heads/dev/dist/all.json
# VITE_DEVELOPER_CATALOG_URL=https://raw.githubusercontent.com/shay-wong/axonhub/beta/frontend/src/features/models/data/providers.json

# NOTE: To override for development, create .env.development.local
# (NOT .env.local, because .env.development has higher priority in dev mode)
